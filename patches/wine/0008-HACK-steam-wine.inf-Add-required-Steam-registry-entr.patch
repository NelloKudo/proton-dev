From 9ec0ff723966526754fa094a045e10343587e25f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Tue, 14 Nov 2023 11:35:53 +0100
Subject: [PATCH 08/17] HACK: steam: wine.inf: Add required Steam registry
 entries.

(cherry picked from commit e847516750758f54d06f0f0e8f8a489dcb62e3a4)
---
 loader/wine.inf.in | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 965d3b261c2..0986e02e2b6 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -70,6 +70,7 @@ AddReg=\
     Printing,\
     Services, \
     SessionMgr,\
+    SteamClient,\
     ThemeManager
 
 [DefaultInstall]
@@ -96,6 +97,7 @@ Needs=BaseInstall
 WineFakeDlls=FakeDllsWin64
 AddReg=\
     CurrentVersionWow64.ntamd64,\
+    SteamClient64, \
     VCRuntime.ntamd64,\
     VersionInfo
 
@@ -104,6 +106,7 @@ Needs=BaseInstall
 WineFakeDlls=FakeDllsWin64
 AddReg=\
     CurrentVersionWow64.ntarm64,\
+    SteamClient64, \
     VCRuntime.ntamd64,\
     VCRuntime.ntarm64,\
     VersionInfo
@@ -125,6 +128,7 @@ AddReg=\
 Needs=BaseWow64Install
 AddReg=\
     CurrentVersionWow64.ntx86,\
+    SteamClient64, \
     VCRuntime.ntamd64,\
     VCRuntime.ntx86
 
@@ -1355,3 +1359,19 @@ InfFiles  = 17
 NlsFiles  = 11
 SortFiles = 10,globalization\sorting
 WinmdFiles = 11,winmetadata
+
+[SteamClient]
+HKCU,Software\Valve\Steam,"SteamPath",,"%16422%\Steam"
+HKCU,Software\Valve\Steam,"SteamExe",,"%16422%\Steam\Steam.exe"
+HKCU,Software\Valve\Steam\ActiveProcess,"PID",0x10001,0x0000fffe
+HKCU,Software\Valve\Steam\ActiveProcess,"SteamClientDll",,"%16422%\Steam\steamclient.dll"
+HKCU,Software\Valve\Steam\ActiveProcess,"SteamPath",,"%16422%\Steam"
+
+[SteamClient64]
+HKCU,Software\Valve\Steam,"SteamPath",,"%16422%\Steam"
+HKCU,Software\Valve\Steam,"SteamExe",,"%16422%\Steam\Steam.exe"
+HKCU,Software\Valve\Steam\ActiveProcess,"PID",0x10001,0x0000fffe
+HKCU,Software\Valve\Steam\ActiveProcess,"SteamClientDll",,"%16426%\Steam\steamclient.dll"
+HKCU,Software\Valve\Steam\ActiveProcess,"SteamClientDll64",,"%16426%\Steam\steamclient64.dll"
+HKCU,Software\Valve\Steam\ActiveProcess,"SteamPath",,"%16426%\Steam"
+HKLM,Software\Wow6432Node\Valve\Steam,"InstallPath",,"%16422%\Steam"
